---
export interface Props {
	title: string;
	body: string;
	href: string;
}

const { href, title, body } = Astro.props;
---

<p class="text-xl text-center xl:text-left text-[theme('colors.green-medium')]">---</p>
<h2 class="text-lg font-bold text-center xl:text-left text-[theme('colors.green-dark')]">
	{title}
</h2>
<p>
	{body}
</p>
<style>

</style>

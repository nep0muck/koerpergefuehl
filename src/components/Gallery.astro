---
import ImageComponent from '../components/ImageComponent.astro';

import image05 from '../assets/img/physiopraxis_05.jpg';
import image06 from '../assets/img/physiopraxis_06.jpg';
import image07 from '../assets/img/physiopraxis_07.jpg';
import image08 from '../assets/img/physiopraxis_08.jpg';
import image09 from '../assets/img/physiopraxis_09.jpg';
import image10 from '../assets/img/physiopraxis_10.jpg';
---

<section class="max-w-screen-xl mx-auto mb-12">
    <h2 class="text-2xl font-bold pb-9 text-center">Wie sieht es bei <span class="logo-text-first">Körper</span><span class="logo-text-second">gefühl</span> aus?</h2>
    <div class="max-w-3xl mx-auto mb-12 prose">
        <p class="mb-3">
            In unseren hellen, großzügigen Räumen erwartet Dich ein freundliches Team, das mit Fachwissen, Empathie und echter Freude an der Arbeit für Deine körperliche Gesundheit da ist.
        </p>
    </div>
    <ul id="behandlungen" role="list" class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:p-0">
        <li class="rounded-md list-none text-center bg-green-light">
            <ImageComponent
                src={image05}
                alt=""
                classes="rounded-md"
            />
        </li>
        <li class="rounded-md list-none text-center bg-green-light">
            <ImageComponent
                src={image06}
                alt=""
                classes="rounded-md"
            />
        </li>
        <li class="rounded-md list-none text-center bg-green-light">
            <ImageComponent
                src={image07}
                alt=""
                classes="rounded-md"
            />
        </li>
        <li class="rounded-md list-none text-center bg-green-light">
            <ImageComponent
                src={image08}
                alt=""
                classes="rounded-md"
            />
        </li>
        <li class="rounded-md list-none text-center bg-green-light">
            <ImageComponent
                src={image09}
                alt=""
                classes="rounded-md"
            />
        </li>
        <li class="rounded-md list-none text-center bg-green-light">
            <ImageComponent
                src={image10}
                alt=""
                classes="rounded-md"
            />
        </li>
    </ul>
</section>

<style>

</style>

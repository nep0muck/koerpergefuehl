---
import { Image } from 'astro:assets';

export interface Props {
	title?: string;
	src: string;
    classes?: string;
    alt?: string;
}

const { title, src, classes, alt } = Astro.props;
---

<Image
    src={src}
    alt={alt}
    class={classes}
/>

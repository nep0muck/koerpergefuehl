---
export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!-- Grundlegende SEO -->
<title>{title}</title>
<meta name="description" content="Körpergefühl – Ihre Praxis für Physiotherapie, Heilpraktik und ganzheitliche Behandlungen in Bremen-Hemelingen. Jetzt Termin vereinbaren!">
<meta name="keywords" content="Physiotherapie Bremen, Heilpraktiker Bremen, Krankengymnastik Bremen, Lymphdrainage Bremen, Massage Bremen">

<!-- Mobile & Encoding -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
<meta property="og:title" content="Körpergefühl – Physiotherapie & Heilpraktik in Bremen-Hemelingen">
<meta property="og:description" content="Ganzheitliche Physiotherapie, Lymphdrainage, Rotlichttherapie & Heilpraktik – Körpergefühl Bremen-Hemelingen.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://physio-koerpergefuehl.de">
<meta property="og:image" content="https://physio-koerpergefuehl.de/assets/og-image.jpg">

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Körpergefühl – Physiotherapie & Heilpraktik">
<meta name="twitter:description" content="Ihre ganzheitliche Praxis in Bremen-Hemelingen.">
<meta name="twitter:image" content="https://physio-koerpergefuehl.de/assets/og-image.jpg">

<!-- Canonical -->
<link rel="canonical" href="https://physio-koerpergefuehl.de">

<link rel="icon" type="image/svg+xml" href="favicon.ico" />

<!-- Structured Data: Local Business -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Physician",
  "name": "Körpergefühl – Physiotherapie & Heilpraktik",
  "image": "https://physio-koerpergefuehl.de/assets/og-image.jpg",
  "@id": "",
  "url": "https://physio-koerpergefuehl.de",
  "telephone": "+49 421 98964633",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Hemelinger Heerstraße 50 / Eingang Bultstr. 1",
    "addressLocality": "Bremen",
    "postalCode": "28309",
    "addressCountry": "DE"
  },
  "openingHours": "Mo-Fr 08:00-18:00"
}
</script>

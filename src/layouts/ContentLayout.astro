---
import HeadComponent from "../components/HeadComponent.astro";
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"


export interface Props {
	title: string;
}

const { title } = Astro.props;

import '../../global.css';
---

<!DOCTYPE html>
<html lang="de">
	<head>
		<HeadComponent title={title} />
	</head>
	<body class="text-[theme('colors.green-dark')] accent-[theme('colors.green-medium')] ">
		<Nav />
		<div class="max-w-screen-xl mx-auto mb-12 px-6 md:px-0">
			<slot />
		</div>
		<Footer id="footer" />
	</body>
</html>
<style>
</style>
